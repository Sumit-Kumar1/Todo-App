# APP configs
APP_NAME=todoapp
ENV=dev
HTTP_PORT=8080
LOG_LEVEL=DEBUG
# migration methods : only two values : UP, DOWN  (case-sensitive)
MIGRATION_METHOD=UP

IDLE_TIMEOUOT=10
READ_TIMEOUT=5
WRITE_TIMEOUT=5

# Database connection
DB_HOST="localhost"
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_NAME="todo"

# logging file
APP_LOG_FILE=app.log

# RATE LIMITING ATTEMPTS, time windows in sec
GLOBAL_ATTEMPTS=300
GLOBAL_TIME_WINDOW=300
LOGIN_ATTEMPTS=10
LOGIN_TIME_WINDOW=60