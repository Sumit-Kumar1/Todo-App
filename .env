# APP configs
APP_NAME=todoapp
ENV=dev
HTTP_PORT=9001
LOG_LEVEL=DEBUG
# migration methods : only two values : UP, DOWN  (case-sensitive)
MIGRATION_METHOD=UP

IDLE_TIMEOUOT=10
READ_TIMEOUT=5
WRITE_TIMEOUT=5

# Database connection
DB_HOST="localhost"
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_NAME="todo"

# logging file
APP_LOG_FILE=app.log
